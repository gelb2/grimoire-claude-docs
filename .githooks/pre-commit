#!/bin/sh
# claude-docs pre-commit hook — HARNESS 인벤토리 + drift + 적대적 검증 (레드팀 헌법)
# 책 Ch 16 "shared contracts" — 인벤토리 변경 시 즉시 갱신 강제
#
# 2026-07-13 (H-1 이중실행 봉합): eval 회귀 게이트(75 task)를 pre-push로 이관.
#   실측 근거 (raw):
#     (1) eval-runner 단일 실행 = ~240s → Bash 기본 2분 timeout 초과 → 커밋 파싱실패·salvage 빈발.
#     (2) eval task auto-sensor-adversarial-pre-commit(116s) + auto-sensor-security-gate(66s) 등이
#         sensor-adversarial / sensor-security-gate 를 "실행"함 → pre-commit이 직접 실행하는 sensor와
#         동일 sensor 3중 실행 (redteam-gate + eval task + pre-commit step 4/4).
#     (3) sensor-security-gate는 운영(prod) curl(--max-time 無)을 포함 → pre-commit이 네트워크 의존·비결정적.
#   → eval을 push 경계(통합 시점)로 이관 (.githooks/pre-push):
#       커버리지 eval 75/75 그대로 유지, pre-commit은 결정적·고속(<1분).
#       pre-commit은 적대적 헌법 게이트(레드팀)만 유지 = 게이트 강도 약화 0 (중복·네트워크 의존만 제거).
#
# claude-docs는 런타임 코드 없으므로 매 commit 부담 작음 (~0s + ~0s + ~36s adversarial).
# server/web 레포는 별도 .githooks/pre-push 패턴 (test/build — .githooks/AGENTS.md 참조).
#
# 활성화: git config core.hooksPath .githooks (사용자 1회 실행)
# 우회: git commit --no-verify (긴급 시만 — pretooluse-redteam-gate가 --no-verify 감지 시 적대검증 강제)

set -e

PROJECT_ROOT="/Users/sokol/Git/ProjectGrimoire"

echo "=== claude-docs pre-commit 검증 ==="

echo ""
echo "[1/3] update-harness-inventory --apply (NEW-5 — drift 사전 갱신) ..."
bash "$PROJECT_ROOT/.claude/scripts/update-harness-inventory.sh" --apply || {
  rc=$?
  if [ $rc -eq 1 ]; then
    # drift 발견 → apply가 자동 갱신 → 사용자가 git add 후 재커밋 필요
    echo ""
    echo "⚠️ HARNESS §14.X 카운트 자동 갱신됨. 변경사항 확인 후 git add + 재커밋 필요:"
    echo "   git diff research/HARNESS_ENGINEERING.md"
    echo "   git add research/HARNESS_ENGINEERING.md && git commit ..."
    exit 1
  elif [ $rc -ne 0 ]; then
    echo "❌ update-harness-inventory FAIL (exit=$rc)"
    exit $rc
  fi
}

echo ""
echo "[2/3] instructions-drift-check.sh ..."
bash "$PROJECT_ROOT/.claude/scripts/instructions-drift-check.sh"

echo ""
echo "[3/3] sensor-adversarial-pre-commit.sh (Red Team Constitution 20 Principles) ..."
# 2026-05-04 묶음 KK: set -e가 sensor exit 1(WARN)을 잡아 commit 차단되는 결함 보강
# (set +e/-e 감싸 sensor WARN 허용, FAIL만 차단)
set +e
bash "$PROJECT_ROOT/.claude/scripts/sensor-adversarial-pre-commit.sh"
ADV_RC=$?
set -e
if [ $ADV_RC -ge 2 ]; then
  echo ""
  echo "❌ Constitution 위반 — Commit 차단 (FAIL principles 발견)"
  echo ""
  echo "💡 자동 회복 시도 (Bounded Retry max 2 iterations, #10_6 묶음 Y):"
  echo "   bash $PROJECT_ROOT/.claude/scripts/adversarial-retry-handler.sh"
  echo ""
  echo "💡 자가-비판 발동 (Constitutional AI 패턴):"
  echo "   /socratic-self-critique  (또는 verification-before-completion skill)"
  exit 1
elif [ $ADV_RC -eq 1 ]; then
  echo ""
  echo "⚠️ WARN principles 검토 권장 (commit 허용)"
fi

echo ""
echo "=== pre-commit 검증 통과 (eval 회귀 75 task는 pre-push로 이관 — .githooks/pre-push) ==="
