# ============================================================
# ProjectGrimoire 루트 workspace .gitignore
# ============================================================
# 목적: CLAUDE.md·PLANNING·.claude·prompt-engineering·research를
#       PRIVATE git repo로 박제. grimoire-server/web은 독립 관리.
# ============================================================

# ──────────────── 독립 git 레포 (별도 repo로 관리)
grimoire-server/
grimoire-web/

# ──────────────── 의존성
node_modules/

# ──────────────── 런타임·빌드 산출물 (재생성 가능)
.launchd-logs/

# reports/ — 자율 에이전트 매일 덮어쓰기. INCIDENT만 보존, 나머지 제외
reports/AI_COST_MONITOR.md
reports/COST_AUDIT_REPORT.md
reports/DEV_REPORT.md
reports/PLANNER_REPORT.md
reports/QA_REPORT.md
reports/SWEEP_REPORT.md
reports/VISUAL_CANON_REPORT.md

# ──────────────── 로컬 IDE / OS
.idea/
.obsidian/
.DS_Store
**/.DS_Store

# ──────────────── Obsidian 임시 파일
무제.base
*.base

# ──────────────── Claude Code — 사용자별 (공유 금지)
.claude/settings.local.json
.claude/state/*
# 예외: incident-log.jsonl은 시계열 박제 (Mitchell Ghostty 패턴, 2026-05-06 사용자 명시)
!.claude/state/incident-log.jsonl
# 예외: main-blocked-log.jsonl 시계열 박제 (사용자 명시 2026-05-08 "메인 권한 박아버려")
!.claude/state/main-blocked-log.jsonl
# 예외: sidechain-debug.jsonl 시계열 박제 (사용자 명시 2026-05-09 isSidechain 결함 디버깅)
!.claude/state/sidechain-debug.jsonl
# 예외: edit-write-violation.jsonl 시계열 박제 (PP-7 hook 차단 raw, 사용자 검증)
!.claude/state/edit-write-violation.jsonl
# 예외: Sprint 계약 Draft 영역 (PP-13 화이트리스트 통과 박제 위치, 사용자 명시 정합)
!.claude/state/sprint-*-draft.md
!.claude/state/grimoire-*-draft.md

# ──────────────── git worktree 격리 (worktree-isolation skill, HARNESS §8.10)
.worktrees/
.claude/worktrees/

# ──────────────── Eval 시스템 — 실행 결과 (재실측 가능, 시계열만 baseline.csv + edd-baseline.csv 보존)
eval/results/*/
!eval/results/baseline.csv
!eval/results/edd-baseline.csv

# ──────────────── 민감 파일 (절대 커밋 금지)
# ACCOUNTS.md: API 키·계정·웹훅 시크릿 포함
ACCOUNTS.md
.env
.env.*
*.pem
*.key
*.p12
secrets/
credentials.json

# ──────────────── 기타
*.log
*.tmp
.cache/

# eval baseline SQLite (자동 재생성, csv가 정본)
eval/results/baseline.db
eval/results/baseline.db-journal

# scheduled-tasks MCP 임시 lock (자동 생성, git 추적 외)
.claude/scheduled_tasks.lock

# 개발 참고책자 원본은 저장소 외부에 보관
/V1.1 하네스 엔지니어링 완전정복.pdf
